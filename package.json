{
  "name": "ar7-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*","packages/*","services/*"],
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:mobile": "pnpm --filter ./apps/mobile start",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter ./apps/web build",
    "lint": "echo \"configure linters per workspace\""
  }
}
